# ── AI Video SaaS — copy to .env and fill in ──────────────────────────────
# NEVER commit a real .env. Every secret the app needs is listed here.

# App
APP_NAME="AI Video Studio"
ENV=dev                      # dev | prod
SECRET_KEY=CHANGE-ME-min-32-chars-random-string
DATABASE_URL=sqlite:///./data/app.db
# Production Postgres example:
# DATABASE_URL=postgresql+psycopg2://aivideo:STRONGPASS@postgres:5432/aivideo

# Auth cookies (set COOKIE_SECURE=true in production — HTTPS only)
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com   # optional: share cookies across subdomains

# Frontend origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Storage: "local" (dev) or "s3" (prod / S3-compatible)
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
# S3_BUCKET=
# S3_ENDPOINT_URL=        # e.g. https://s3.amazonaws.com or MinIO/R2 endpoint
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
FILE_URL_TTL_SECONDS=900

# AI providers — keys live ONLY here, never in frontend code
AI_PROVIDER_DEFAULT=mock
# REPLICATE_API_TOKEN=r8_...

# Stripe (use TEST keys in dev: sk_test_... / whsec_...)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:5173/billing?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/billing?payment=cancelled

# Bootstrap super-admin (used by `python -m app.seed` on first run only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Site Admin

# Links used in emails
FRONTEND_URL=http://localhost:5173

# Email (leave empty in dev — emails are logged to stdout instead)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@example.com
